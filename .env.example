# ==============================================================================
# KisanIQ Production & Docker Environment Variables Template
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration (Container: kisaniq-db)
# ------------------------------------------------------------------------------
POSTGRES_DB=kisaniq_db
POSTGRES_USER=kisaniq_user
POSTGRES_PASSWORD=kisaniq_secure_pass_2026

# Internal Docker Network Connection String (Used by kisaniq-backend container)
DATABASE_URL=postgresql://kisaniq_user:kisaniq_secure_pass_2026@db:5432/kisaniq_db

# External PostgreSQL (e.g. Supabase, Neon) override if not using the local Docker db
# DATABASE_URL=postgres://username:password@ep-sample.aws.neon.tech/kisaniq?sslmode=require

# ------------------------------------------------------------------------------
# 2. Backend Service Configuration (Container: kisaniq-backend)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8000

# Security and JWT Token Config
JWT_SECRET_KEY=kisaniq-super-secret-production-key-2026-btech-devops
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost,http://127.0.0.1:5173

# Development Demo Data Seeder (Set true to auto-seed sample farmers & crops on startup)
ALLOW_DEV_SEED=true

# ------------------------------------------------------------------------------
# 3. Agricultural Market & Weather External APIs
# ------------------------------------------------------------------------------
# CEDA Agmarknet Agricultural-Market Data API Key (Bearer Token)
CEDA_API_KEY=
CEDA_BASE_URL=https://api.ceda.ashoka.edu.in/v1

# Mandi Synchronization Security Secret
MANDI_SYNC_SECRET=kisaniq_mandi_sync_secret_token_2026

# Open-Meteo Agricultural Weather API Base URL
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org

# ------------------------------------------------------------------------------
# 4. Frontend Configuration (Container: kisaniq-frontend)
# ------------------------------------------------------------------------------
# Reverse-proxied via Nginx default
VITE_API_URL=/api
VITE_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# 5. Remote Linux Deployment Credentials (GitHub Secrets for CI/CD)
# Configure these in GitHub Repository -> Settings -> Secrets and variables -> Actions
# ------------------------------------------------------------------------------
# DEPLOY_HOST=your-remote-server-ip-or-domain
# DEPLOY_USER=ubuntu
# DEPLOY_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----
# DEPLOY_PATH=/home/ubuntu/kisaniq-deployment
# GHCR_USERNAME=your-github-username
# GHCR_TOKEN=your-github-personal-access-token-or-secret
